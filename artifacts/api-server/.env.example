# Server Configuration
NODE_ENV=production
PORT=3000

# CORS Configuration
ALLOWED_ORIGINS=https://your-vercel-frontend.vercel.app,http://localhost:5173

# BingX API Configuration (Optional - for live market data)
BINGX_API_KEY=
BINGX_API_SECRET=

# Database Configuration (if using PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Logging
LOG_LEVEL=info
